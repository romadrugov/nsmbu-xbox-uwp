# game/ — dump, keys, extracted code/, content/, meta/; game/README.md stays in git
/game/*
!/game/README.md
/game/game.wux
/game/game.key
/game/common.key
*.rpx
# upstream reference checkout
/cemu/
# generated / build output
/build/
/dist/
out/
__pycache__/
node_modules/
filelist.txt
extract.log
.DS_Store
/ref/
trace_dump.txt
/nsmbu/
/save/
compile_commands.json
frame_*.png
failed_shader_*.metal
shaders/
draw_*.png
# never commit game data, keys or anything derived from the game
*.key
*.wud
*.wux
*.wua
*.7z
*.iso
*.rvz
template.bin
shaderprep_template.bin
headstart.bin
# logs and dumps (may contain game text or imagery)
*.log
*.metal
*.tsv
# local coordination board
/task.md
/.tmp/

# iOS build output
runtime/ios/build/
runtime/ios/build-sim/

# Xbox smoke local/generated files
/xbox/smoke/Assets/
/xbox/smoke/output/
/xbox/smoke/x64/
