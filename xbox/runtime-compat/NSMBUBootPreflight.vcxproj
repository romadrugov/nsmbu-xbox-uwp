<?xml version="1.0" encoding="utf-8"?>
<!-- Real activatable UWP lifecycle shell for native Xbox R4 preflight.
     Public fixture and private full game both compile through clang-cl.
     Does NOT execute the game or load RPX/ROM resources. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{FE0D0F71-B9BE-4D4C-A8D4-3CAAC439E19E}</ProjectGuid>
    <RootNamespace>NSMBUBootPreflight</RootNamespace>
    <ProjectName>NSMBUBootPreflight</ProjectName>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <AppContainerApplication>true</AppContainerApplication>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>NSMBUBootPreflight</TargetName>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>true</CompileAsWinRT>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/std:c++17 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NSMBU_R5_CPU_BOOTSTRAP=1;NSMBU_R5C_LINK_AUDIT=1;NSMBU_R5D_RELOC_AUDIT=1;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\runtime\src;$(ProjectDir)..\..\runtime\include;$(ProjectDir)..\smoke;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <AdditionalOptions>/NODEFAULTLIB:vccorlib /NODEFAULTLIB:msvcrt %(AdditionalOptions)</AdditionalOptions>
      <AdditionalDependencies>vccorlib.lib;msvcrt.lib;bcrypt.lib;$(NSMBUR4BridgeObj);$(NSMBUR4MathObj);$(NSMBUR4DispatchObj);$(NSMBUR4RuntimeObj);$(NSMBUR4Archive);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="BootMain.cpp" />
    <ClCompile Include="..\..\runtime\src\core\xbox_guest_vm.cpp" />
    <ClCompile Include="..\..\runtime\src\core\rpx_inspect.cpp" />
    <ClCompile Include="..\..\runtime\src\core\rpx_stage.cpp" />
    <ClCompile Include="..\..\runtime\src\core\r5_startup_metadata.cpp" />
    <ClCompile Include="..\..\runtime\src\core\r5c_link_audit.cpp" />
    <ClCompile Include="..\..\runtime\src\core\r5d_relocation_audit.cpp" />
    <ClCompile Include="..\smoke\RpxProbe.cpp" />
  </ItemGroup>
  <ItemGroup><AppxManifest Include="PackageBootPreflight.appxmanifest" /></ItemGroup>
  <ItemGroup>
    <Content Include="..\smoke\Assets\*.png">
      <Link>Assets\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>