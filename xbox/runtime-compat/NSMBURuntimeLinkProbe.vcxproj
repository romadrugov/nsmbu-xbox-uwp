<?xml version="1.0" encoding="utf-8"?>
<!-- Source-only UWP executable-link gate. Not an AppX and never launched on an Xbox. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{DD8EE604-2142-4AA2-A5CB-1DA902CB15D3}</ProjectGuid>
    <RootNamespace>NSMBURuntimeLinkProbe</RootNamespace>
    <ProjectName>NSMBURuntimeLinkProbe</ProjectName>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <AppContainerApplication>true</AppContainerApplication>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>NSMBURuntimeLinkProbe</TargetName>
    <NSMBUCompatArchive Condition="'$(NSMBUCompatArchive)' == ''">$(ProjectDir)NSMBURuntimeCompat.lib</NSMBUCompatArchive>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>true</CompileAsWinRT>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/std:c++17 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(NSMBUPrivateArchive)' != ''">NSMBU_PRIVATE_GAME_LINK;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\runtime\src;$(ProjectDir)..\..\runtime\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <AdditionalDependencies Condition="'$(NSMBUPrivateArchive)' == ''">$(NSMBUCompatArchive);%(AdditionalDependencies)</AdditionalDependencies>
      <!-- UWP C++/CX requires the WinRT CRT to precede msvcrt when linking clang-cl PPC objects. -->
      <AdditionalOptions Condition="'$(NSMBUPrivateArchive)' != ''">/NODEFAULTLIB:vccorlib /NODEFAULTLIB:msvcrt %(AdditionalOptions)</AdditionalOptions>
      <AdditionalDependencies Condition="'$(NSMBUPrivateArchive)' != ''">vccorlib.lib;msvcrt.lib;$(NSMBUPrivateBridgeObj);$(NSMBUMathObject);$(NSMBUHeadlessDispatchObj);$(NSMBUBootFirstRuntimeObj);$(NSMBUPrivateArchive);$(NSMBUCompatArchive);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="link_probe.cpp" /></ItemGroup>
  <ItemGroup><AppxManifest Include="Package.appxmanifest" /></ItemGroup>
  <ItemGroup>
    <Content Include="..\smoke\Assets\*.png">
      <Link>Assets\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
